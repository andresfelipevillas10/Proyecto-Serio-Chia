<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardContenedor"
    android:layout_width="260dp"
    android:layout_height="wrap_content"
    android:layout_marginEnd="16dp"
    android:layout_marginVertical="8dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="#ffffff"
    app:strokeWidth="1dp"
    app:strokeColor="#1Ac3c6d1"> <androidx.constraintlayout.widget.ConstraintLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="20dp">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cvIconBackground"
        android:layout_width="48dp"
        android:layout_height="48dp"
        app:cardCornerRadius="24dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="#1A001e40"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/ivRouteIcon"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="12dp"
            android:src="@drawable/ic_route"
            app:tint="#001e40" />
    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:id="@+id/tvRouteBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="FRECUENTE"
        android:textSize="10sp"
        android:textStyle="bold"
        android:textColor="#ffffff"
        android:background="@drawable/bg_badge_white_alpha"
        android:paddingHorizontal="8dp"
        android:paddingVertical="4dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/cvIconBackground"
        app:layout_constraintStart_toEndOf="@id/cvIconBackground"
        android:layout_marginStart="8dp" />

    <ImageButton
        android:id="@+id/btnRemoveRoute"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_close"
        app:tint="#737780"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvRouteName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Ruta 2 - Samaria"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#191c1d"
        android:layout_marginTop="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/cvIconBackground" />

    <TextView
        android:id="@+id/tvRouteDetails"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="35 min • 8 Paradas"
        android:textSize="12sp"
        android:textColor="#43474F"
        android:layout_marginTop="4dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvRouteName" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnStartRoute"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="24dp"
        android:text="Seleccionar"
        android:textColor="#ffffff"
        android:textStyle="bold"
        app:backgroundTint="#001e40"
        android:alpha="0.5"
        app:cornerRadius="12dp"
        app:layout_constraintTop_toBottomOf="@id/tvRouteDetails" />

</androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>