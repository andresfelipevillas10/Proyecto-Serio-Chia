<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="32dp"
    android:background="#F8F9FA"> <ImageView
    android:layout_width="120dp"
    android:layout_height="120dp"
    android:src="@drawable/logo_chia"
    android:layout_marginBottom="24dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Bienvenido, Conductor"
        android:textSize="26sp"
        android:textStyle="bold"
        android:textColor="#001e40" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Espacio reservado para el mapa y las rutas."
        android:textColor="#43474F"
        android:textAlignment="center"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="48dp"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnLogoutTest"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="Cerrar Sesión (Modo Test)"
        android:textColor="#ba1a1a"
        app:strokeColor="#ba1a1a"
        app:cornerRadius="16dp" />

</LinearLayout>