<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bg_zenda">

    <!-- Mapa: ocupa el espacio desde arriba hasta el panel inferior -->
    <fragment
            android:id="@+id/mapSeguimiento"
            android:name="com.google.android.gms.maps.SupportMapFragment"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toTopOf="@id/bottomPanel"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Botón atrás flotante sobre el mapa -->
    <ImageButton
            android:id="@+id/btnBackSeguimiento"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_back"
            android:background="@drawable/bg_white_rounded_small"
            android:elevation="6dp"
            android:padding="8dp"
            android:contentDescription="Volver"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginTop="16dp"
            android:layout_marginStart="16dp"/>

    <!-- Panel de información inferior -->
    <com.google.android.material.card.MaterialCardView
            android:id="@+id/bottomPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="24dp"
            app:cardElevation="12dp"
            app:cardBackgroundColor="@color/bg_zenda"
            app:strokeWidth="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="20dp"
                android:paddingTop="20dp"
                android:paddingBottom="28dp">

            <!-- Nombre ruta + badge EN VIVO -->
            <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                <TextView
                        android:id="@+id/tvSeguimientoRutaNombre"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="Cargando ruta..."
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_main"
                        android:layout_toStartOf="@+id/badgeLiveSeguimiento"
                        android:layout_marginEnd="8dp"
                        android:layout_centerVertical="true"/>

                <TextView
                        android:id="@+id/badgeLiveSeguimiento"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="● EN VIVO"
                        android:background="@drawable/bg_live_badge"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="4dp"
                        android:textColor="@color/primary_zenda"
                        android:textSize="9sp"
                        android:textStyle="bold"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"/>
            </RelativeLayout>

            <!-- Divider -->
            <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/input_stroke"
                    android:layout_marginTop="14dp"
                    android:layout_marginBottom="14dp"/>

            <!-- Label sección paradas -->
            <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PRÓXIMAS PARADAS"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_variant"
                    android:letterSpacing="0.12"/>

            <!-- Parada 1: próxima (resaltada) -->
            <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="12dp">

                <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_location_on"
                        app:tint="@color/primary_zenda"/>

                <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="10dp">

                    <TextView
                            android:id="@+id/tvProximaParada"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Cargando..."
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:textColor="@color/text_main"/>

                    <TextView
                            android:id="@+id/tvHoraEstimada"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Calculando tiempo..."
                            android:textSize="12sp"
                            android:textColor="@color/primary_zenda"/>
                </LinearLayout>
            </LinearLayout>

            <!-- Parada 2 -->
            <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="10dp">

                <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_stop"
                        app:tint="@color/text_hint"/>

                <TextView
                        android:id="@+id/tvSiguienteParada"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="—"
                        android:textSize="14sp"
                        android:textColor="@color/text_variant"
                        android:layout_marginStart="10dp"/>
            </LinearLayout>

            <!-- Parada 3 -->
            <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="8dp">

                <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_stop"
                        app:tint="@color/text_hint"/>

                <TextView
                        android:id="@+id/tvTercerParada"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="—"
                        android:textSize="14sp"
                        android:textColor="@color/text_variant"
                        android:layout_marginStart="10dp"/>
            </LinearLayout>

            <!-- Botón: Cómo llegar al paradero -->
            <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnComoLlegar"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="16dp"
                    android:text="¿Cómo llegar al paradero?"
                    android:textAllCaps="false"
                    android:textStyle="bold"
                    app:icon="@drawable/ic_navigation"
                    app:iconGravity="textStart"
                    app:cornerRadius="100dp"
                    app:backgroundTint="@color/primary_zenda"/>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>
