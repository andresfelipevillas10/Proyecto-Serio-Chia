<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:layout_marginHorizontal="2dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp"
        app:strokeWidth="1dp"
        app:strokeColor="#1Ac3c6d1"
        app:cardBackgroundColor="#FFFFFF">

    <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="12dp">

        <TextView
                android:id="@+id/tvOrdenPuntoItem"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/bg_point_number"
                android:gravity="center"
                android:text="1"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />

        <TextView
                android:id="@+id/tvNombrePuntoItem"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="8dp"
                android:text="Terminal Chía"
                android:textColor="#001e40"
                android:textSize="14sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end"
                app:layout_constraintStart_toEndOf="@id/tvOrdenPuntoItem"
                app:layout_constraintEnd_toStartOf="@id/tvTipoPuntoItem"
                app:layout_constraintTop_toTopOf="@id/tvOrdenPuntoItem"
                app:layout_constraintBottom_toTopOf="@id/tvCoordenadasPuntoItem"
                 />

        <TextView
                android:id="@+id/tvTipoPuntoItem"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_badge_oblig"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                android:text="OBLIG."
                android:textColor="#006c49"
                android:textSize="9sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="@id/tvNombrePuntoItem"
                app:layout_constraintEnd_toStartOf="@id/btnModificarPunto"
                app:layout_constraintTop_toTopOf="@id/tvNombrePuntoItem" />

        <TextView
                android:id="@+id/tvCoordenadasPuntoItem"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="4.8631° N, 74.0538° W"
                android:textColor="#737780"
                android:textSize="10sp"
                app:layout_constraintStart_toEndOf="@id/tvOrdenPuntoItem"
                app:layout_constraintEnd_toStartOf="@id/btnModificarPunto"
                app:layout_constraintTop_toBottomOf="@id/tvNombrePuntoItem"
                app:layout_constraintBottom_toBottomOf="@id/tvOrdenPuntoItem" />

        <ImageButton
                android:id="@+id/btnModificarPunto"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_circle_light_blue"
                android:src="@drawable/ic_edit"
                app:tint="#001e40"
                android:padding="6dp"
                android:scaleType="centerInside"
                app:layout_constraintEnd_toStartOf="@id/btnEliminarPunto"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />

        <ImageButton
                android:id="@+id/btnEliminarPunto"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/bg_circle_light_red"
                android:src="@drawable/ic_delete"
                app:tint="#ba1a1a"
                android:padding="6dp"
                android:scaleType="centerInside"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>