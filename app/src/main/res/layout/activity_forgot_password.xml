<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:background="@color/bg_zenda">

    <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="24dp">

        <!-- Contenedor central con ancho máximo para pantallas grandes -->
        <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintWidth_max="480dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

            <ImageButton
                    android:id="@+id/btnBackRecover"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_back"
                    app:tint="@color/primary_zenda"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent" />

            <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Recuperar Acceso"
                    android:textColor="@color/primary_zenda"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:layout_marginStart="8dp"
                    app:layout_constraintTop_toTopOf="@id/btnBackRecover"
                    app:layout_constraintBottom_toBottomOf="@id/btnBackRecover"
                    app:layout_constraintStart_toEndOf="@id/btnBackRecover" />

            <TextView
                    android:id="@+id/tvBrandRecover"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Zenda"
                    android:textSize="48sp"
                    android:textStyle="bold"
                    android:textColor="@color/primary_zenda"
                    android:layout_marginTop="32dp"
                    app:layout_constraintTop_toBottomOf="@id/btnBackRecover"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

            <LinearLayout
                    android:id="@+id/accentBarRecover"
                    android:layout_width="64dp"
                    android:layout_height="4dp"
                    android:orientation="horizontal"
                    android:layout_marginTop="4dp"
                    app:layout_constraintTop_toBottomOf="@id/tvBrandRecover"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">
                <View android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@color/accent_yellow" />
                <View android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@color/accent_blue" />
                <View android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@color/accent_red" />
            </LinearLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/illustrationContainer"
                    android:layout_width="200dp"
                    android:layout_height="200dp"
                    android:layout_marginTop="24dp"
                    app:layout_constraintTop_toBottomOf="@id/accentBarRecover"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">

                <View
                        android:layout_width="160dp"
                        android:layout_height="160dp"
                        android:background="@drawable/dot_indicator"
                        android:backgroundTint="@color/primary_zenda"
                        android:alpha="0.05"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />

                <View
                        android:layout_width="140dp"
                        android:layout_height="140dp"
                        android:background="@drawable/bg_profile_circle"
                        android:alpha="0.2"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />

                <androidx.cardview.widget.CardView
                        android:layout_width="100dp"
                        android:layout_height="100dp"
                        app:cardCornerRadius="24dp"
                        app:cardElevation="8dp"
                        android:rotation="12"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent">
                    <ImageView
                            android:layout_width="60dp"
                            android:layout_height="60dp"
                            android:layout_gravity="center"
                            android:rotation="-12"
                            android:src="@drawable/ic_key"
                            app:tint="@color/primary_zenda" />
                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        app:cardBackgroundColor="@color/accent_blue"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="10dp"
                        android:rotation="-12"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        android:layout_marginBottom="20dp"
                        android:layout_marginEnd="20dp">
                    <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_lock"
                            app:tint="#FFFFFF" />
                </androidx.cardview.widget.CardView>
            </androidx.constraintlayout.widget.ConstraintLayout>

            <TextView
                    android:id="@+id/tvEditorialTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="¿HAS PERDIDO EL RUMBO?"
                    android:textAlignment="center"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_main"
                    android:layout_marginTop="24dp"
                    app:layout_constraintTop_toBottomOf="@id/illustrationContainer"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

            <TextView
                    android:id="@+id/tvEditorialDesc"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="No te preocupes, recuperemos tu acceso para que puedas seguir tu camino con tranquilidad."
                    android:textAlignment="center"
                    android:textSize="14sp"
                    android:textColor="@color/text_variant"
                    android:layout_marginTop="12dp"
                    app:layout_constraintTop_toBottomOf="@id/tvEditorialTitle"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

            <LinearLayout
                    android:id="@+id/formRecover"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="32dp"
                    app:layout_constraintTop_toBottomOf="@id/tvEditorialDesc"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">

                <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="CORREO ELECTRÓNICO"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_variant"
                        android:layout_marginStart="8dp"/>

                <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.MaterialComponents.TextInputLayout.FilledBox.Dense"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        app:hintEnabled="false"
                        app:boxBackgroundColor="@color/surface_input"
                        app:boxCornerRadiusTopStart="16dp" app:boxCornerRadiusTopEnd="16dp"
                        app:boxCornerRadiusBottomStart="16dp" app:boxCornerRadiusBottomEnd="16dp"
                        app:boxStrokeWidth="0dp">

                    <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etEmailRecover"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="nombre@zenda.com"
                            android:inputType="textEmailAddress"
                            android:paddingTop="18dp"
                            android:paddingBottom="18dp" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSendInstructions"
                        android:layout_width="match_parent"
                        android:layout_height="64dp"
                        android:layout_marginTop="32dp"
                        android:text="Enviar Instrucciones"
                        android:textAllCaps="false"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        app:backgroundTint="@null"
                        android:background="@drawable/bg_button_gradient"
                        app:icon="@drawable/ic_arrow_forward"
                        app:iconGravity="textEnd"
                        app:cornerRadius="100dp" />

                <TextView
                        android:id="@+id/tvBackToLogin"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginTop="24dp"
                        android:layout_marginBottom="32dp"
                        android:text="Volver al Inicio de Sesión"
                        android:textColor="@color/primary_zenda"
                        android:textStyle="bold"
                        android:drawableStart="@drawable/ic_login"
                        android:drawablePadding="8dp" />
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>