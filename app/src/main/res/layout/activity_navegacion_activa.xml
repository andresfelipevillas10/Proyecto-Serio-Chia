<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#E1E3E4">

    <androidx.fragment.app.FragmentContainerView
            android:id="@+id/mapNavegacion"
            android:name="com.google.android.libraries.navigation.SupportNavigationFragment"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

    <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardNextStop"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="32dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="12dp"
            app:cardBackgroundColor="#F2FFFFFF"
            app:strokeWidth="1dp"
            app:strokeColor="#33c3c6d1"
            app:layout_constraintBottom_toTopOf="@id/bottomNavContainer"
            android:layout_marginBottom="16dp">

        <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="16dp"
                android:gravity="center_vertical">

            <LinearLayout
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_circle_primary"
                    android:gravity="center"
                    android:elevation="4dp">
                <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_location_on"
                        app:tint="#FFFFFF" />
            </LinearLayout>

            <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="16dp"
                    android:orientation="vertical">

                <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="PRÓXIMA PARADA"
                        android:textColor="#737780"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.1" />

                <TextView
                        android:id="@+id/tvActiveNextStop"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Parque Principal"
                        android:textColor="#001e40"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="2dp">

                    <ImageView
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:src="@drawable/ic_navigation"
                            app:tint="#006c49" />

                    <TextView
                            android:id="@+id/tvActiveDistance"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:text="200m"
                            android:textColor="#006c49"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                    <TextView
                            android:id="@+id/tvActiveTime"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="aprox. 1 min"
                            android:textColor="#737780"
                            android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>



    <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fabReportarNovedad"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="24dp"
            android:src="@drawable/ic_warning"
            app:tint="#FFFFFF"
            app:backgroundTint="#F29900"
            app:elevation="8dp"
            app:fabSize="normal"
            app:layout_constraintBottom_toTopOf="@id/cardNextStop"
            app:layout_constraintEnd_toEndOf="parent" />

    <TextView
            android:id="@+id/tvReportarLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Reportar"
            android:textColor="#001e40"
            android:textSize="12sp"
            android:textStyle="bold"
            android:background="@drawable/bg_white_rounded_small"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp"
            android:layout_marginBottom="4dp"
            app:layout_constraintBottom_toTopOf="@id/fabReportarNovedad"
            app:layout_constraintEnd_toEndOf="@id/fabReportarNovedad"
            app:layout_constraintStart_toStartOf="@id/fabReportarNovedad" />

    <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fabPausarRuta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="24dp"
            android:src="@drawable/ic_pause"
            app:tint="#FFFFFF"
            app:backgroundTint="#006c49"
            app:elevation="8dp"
            app:fabSize="normal"
            app:layout_constraintBottom_toTopOf="@id/cardNextStop"
            app:layout_constraintEnd_toStartOf="@id/fabReportarNovedad" />

    <TextView
            android:id="@+id/tvPausarLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Pausar"
            android:textColor="#001e40"
            android:textSize="12sp"
            android:textStyle="bold"
            android:background="@drawable/bg_white_rounded_small"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp"
            android:layout_marginBottom="4dp"
            app:layout_constraintBottom_toTopOf="@id/fabPausarRuta"
            app:layout_constraintEnd_toEndOf="@id/fabPausarRuta"
            app:layout_constraintStart_toStartOf="@id/fabPausarRuta" />

    <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/bottomNavContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_surface_rounded_top"
            android:elevation="16dp"
            android:padding="24dp"
            app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                app:layout_constraintBottom_toBottomOf="parent">

            <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSafetyExit"
                    android:layout_width="0dp"
                    android:layout_height="64dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="12dp"
                    android:text="SALIR"
                    android:textColor="#ba1a1a"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:backgroundTint="#FFFFFF"
                    app:strokeColor="#ba1a1a"
                    app:strokeWidth="2dp"
                    app:cornerRadius="16dp"
                    app:icon="@drawable/ic_close"
                    app:iconGravity="textStart"
                    app:iconTint="#ba1a1a" />

            <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnEndRoute"
                    android:layout_width="0dp"
                    android:layout_height="64dp"
                    android:layout_weight="1.5"
                    android:text="FINALIZAR"
                    android:textColor="#ffffff"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:backgroundTint="#ba1a1a"
                    app:cornerRadius="16dp"
                    app:icon="@drawable/ic_stop"
                    app:iconGravity="textStart" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>