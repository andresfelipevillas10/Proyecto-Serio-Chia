<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bg_zenda">

    <!-- ── Top bar ── -->
    <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/topBar"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:paddingHorizontal="20dp"
            android:background="@color/bg_zenda"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

        <ImageView
                android:id="@+id/ivLogo"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_bus"
                app:tint="@color/primary_zenda"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"/>

        <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Zenda"
                android:textColor="@color/primary_zenda"
                android:textStyle="bold"
                android:textSize="20sp"
                android:layout_marginStart="8dp"
                app:layout_constraintTop_toTopOf="@id/ivLogo"
                app:layout_constraintBottom_toBottomOf="@id/ivLogo"
                app:layout_constraintStart_toEndOf="@id/ivLogo"/>

        <TextView
                android:id="@+id/tvBadgePasajero"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PASAJERO"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="@color/primary_zenda"
                android:background="@drawable/bg_live_badge"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- ── Barra tricolor ── -->
    <LinearLayout
            android:id="@+id/identityBar"
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:orientation="horizontal"
            app:layout_constraintTop_toBottomOf="@id/topBar"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">
        <View android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_weight="1" android:background="@color/accent_yellow"/>
        <View android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_weight="1" android:background="@color/accent_blue"/>
        <View android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_weight="1" android:background="@color/accent_red"/>
    </LinearLayout>

    <!-- ── Scroll principal ── -->
    <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintTop_toBottomOf="@id/identityBar"
            app:layout_constraintBottom_toTopOf="@id/bottomNavPasajero"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

            <!-- Saludo -->
            <TextView
                    android:id="@+id/tvGreeting"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="¡Hola, Pasajero!"
                    android:textSize="26sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_main"/>

            <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Encuentra tu bus en tiempo real"
                    android:textColor="@color/text_variant"
                    android:textSize="14sp"
                    android:layout_marginTop="2dp"/>

            <!-- Título sección rutas -->
            <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Rutas en servicio ahora"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_main"
                    android:layout_marginTop="24dp"
                    android:layout_marginBottom="12dp"/>

            <!-- Estado vacío -->
            <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardEmptyState"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="visible"
                    app:cardElevation="0dp"
                    app:cardCornerRadius="16dp"
                    app:cardBackgroundColor="@color/surface_container_low"
                    app:strokeColor="@color/input_stroke"
                    app:strokeWidth="1dp">

                <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="32dp"
                        android:gravity="center">

                    <ImageView
                            android:layout_width="52dp"
                            android:layout_height="52dp"
                            android:src="@drawable/ic_bus"
                            app:tint="@color/text_hint"/>

                    <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="No hay rutas activas en este momento."
                            android:textColor="@color/text_variant"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:gravity="center"
                            android:layout_marginTop="12dp"/>

                    <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Cuando un conductor inicie un recorrido\naparecerá aquí en tiempo real."
                            android:textColor="@color/text_hint"
                            android:textSize="13sp"
                            android:gravity="center"
                            android:layout_marginTop="6dp"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Lista de recorridos activos -->
            <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvRutasSalientes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    android:visibility="gone"/>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- ── Bottom Nav ── -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/bottomNavPasajero"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_bottom_nav"
            app:elevation="8dp"
            app:itemIconTint="@color/nav_icon_selector"
            app:itemTextColor="@color/nav_text_selector"
            app:menu="@menu/bottom_nav_passenger_menu"
            app:labelVisibilityMode="labeled"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>
