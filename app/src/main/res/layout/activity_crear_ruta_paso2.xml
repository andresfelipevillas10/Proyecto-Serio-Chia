<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bg_zenda">

    <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/topBar"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:paddingHorizontal="20dp"
            android:background="#FAFAFA"
            app:layout_constraintTop_toTopOf="parent">

        <ImageButton
                android:id="@+id/btnBackPaso2"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_back"
                app:tint="@color/primary_zenda"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

        <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginStart="12dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@id/btnBackPaso2">
            <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Crear Ruta"
                    android:textColor="@color/primary_zenda"
                    android:textSize="18sp"
                    android:textStyle="bold" />
            <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PASO 2 DE 2: DEFINICIÓN DE PUNTOS"
                    android:textColor="@color/text_variant"
                    android:textSize="9sp"
                    android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent">
            <View android:layout_width="6dp" android:layout_height="6dp" android:background="@drawable/dot_indicator" android:backgroundTint="@color/accent_yellow"/>
            <View android:layout_width="6dp" android:layout_height="6dp" android:layout_marginStart="4dp" android:background="@drawable/dot_indicator" android:backgroundTint="@color/accent_blue"/>
            <View android:layout_width="6dp" android:layout_height="6dp" android:layout_marginStart="4dp" android:background="@drawable/dot_indicator" android:backgroundTint="@color/error"/>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <com.google.android.material.card.MaterialCardView
            android:id="@+id/mapContainer"
            android:layout_width="match_parent"
            android:layout_height="320dp"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="24dp"
            app:cardElevation="4dp"
            app:layout_constraintTop_toBottomOf="@id/topBar">

        <androidx.fragment.app.FragmentContainerView
                android:id="@+id/mapConfigurarPuntos"
                android:name="com.google.android.gms.maps.SupportMapFragment"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

        <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="12dp"
                android:background="@drawable/bg_card_zenda"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:elevation="6dp">
            <View android:layout_width="8dp" android:layout_height="8dp" android:background="@drawable/dot_indicator" android:backgroundTint="@color/primary_zenda" />
            <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="Editando Ruta"
                    android:textColor="@color/text_variant"
                    android:textSize="10sp"
                    android:textStyle="bold" />
        </LinearLayout>

        <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/btnMyLocation"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|end"
                android:layout_margin="16dp"
                android:src="@drawable/ic_navigation"
                app:backgroundTint="#FFFFFF"
                app:tint="@color/primary_zenda"
                app:fabSize="mini" />
    </com.google.android.material.card.MaterialCardView>

    <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/containerLista"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="16dp"
            android:layout_marginHorizontal="16dp"
            android:background="@drawable/bg_card_zenda"
            android:backgroundTint="@color/surface_container_low"
            app:layout_constraintTop_toBottomOf="@id/mapContainer"
            app:layout_constraintBottom_toTopOf="@id/bottomActions">

        <LinearLayout
                android:id="@+id/headerListaPuntos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="16dp"
                android:gravity="center_vertical"
                app:layout_constraintTop_toTopOf="parent">

            <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_stars"
                    app:tint="@color/primary_zenda"/>

            <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:text="Puntos de Control"
                    android:textColor="@color/text_main"
                    android:textSize="14sp"
                    android:textStyle="bold" />

            <TextView
                    android:id="@+id/tvContadorPuntos"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_live_badge"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="2dp"
                    android:text="0 PUNTOS"
                    android:textColor="@color/primary_zenda"
                    android:textSize="9sp"
                    android:textStyle="bold" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerPuntosConfiguracion"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:paddingHorizontal="12dp"
                android:clipToPadding="false"
                android:paddingBottom="8dp"
                app:layout_constraintTop_toBottomOf="@id/headerListaPuntos"
                app:layout_constraintBottom_toTopOf="@id/btnRecargarPuntos"
                tools:listitem="@layout/item_punto_ruta" />

        <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRecargarPuntos"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="12dp"
                android:layout_marginBottom="12dp"
                android:text="Recargar Puntos"
                android:textColor="@color/text_main"
                android:textSize="12sp"
                app:icon="@drawable/ic_refresh"
                app:iconTint="@color/text_main"
                app:backgroundTint="@color/surface_container_highest"
                app:cornerRadius="12dp"
                app:layout_constraintBottom_toBottomOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <LinearLayout
            android:id="@+id/bottomActions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            app:layout_constraintBottom_toBottomOf="parent">

        <com.google.android.material.button.MaterialButton
                android:id="@+id/btnGuardarConfiguracion"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginBottom="8dp"
                android:text="Finalizar Creación"
                android:textAllCaps="false"
                android:textColor="#ffffff"
                android:textSize="16sp"
                android:textStyle="bold"
                app:backgroundTint="@null"
                android:background="@drawable/bg_button_gradient"
                app:cornerRadius="100dp"
                app:icon="@drawable/ic_check_circle"
                app:iconGravity="textEnd" />

        <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="La ruta será verificada por el sistema central."
                android:textAlignment="center"
                android:textColor="@color/text_variant"
                android:textSize="10sp" />

        <com.google.android.material.bottomnavigation.BottomNavigationView
                android:id="@+id/bottomNav"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_bottom_nav"
                app:elevation="8dp"
                app:itemIconTint="@color/nav_item_color_selector"
                app:itemTextColor="@color/nav_item_color_selector"
                app:menu="@menu/bottom_nav_menu"
                app:labelVisibilityMode="labeled" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>