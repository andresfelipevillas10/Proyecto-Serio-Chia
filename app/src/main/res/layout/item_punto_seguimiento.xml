<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginVertical="6dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="2dp"
        app:strokeWidth="1dp"
        app:strokeColor="#1Ac3c6d1">

    <LinearLayout
            android:id="@+id/layoutItemPuntoSeguimiento"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:background="#F5F5F5">

        <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

            <TextView
                    android:id="@+id/tvNombrePuntoSeguimiento"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="1. Parque Principal"
                    android:textColor="#001e40"
                    android:textSize="16sp"
                    android:textStyle="bold" />

            <TextView
                    android:id="@+id/tvTipoPuntoSeguimiento"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_white_rounded_small"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="4dp"
                    android:text="Tipo: marca"
                    android:textColor="#737780"
                    android:textSize="10sp"
                    android:textStyle="bold" />
        </LinearLayout>

        <TextView
                android:id="@+id/tvEstadoPuntoSeguimiento"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Estado: completado"
                android:textSize="12sp"
                android:textStyle="bold" />

        <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#1A000000"
                android:layout_marginVertical="8dp" />

        <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

            <TextView
                    android:id="@+id/tvTiempoDesdeAnteriorSeguimiento"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Tiempo desde anterior: 00:02:15"
                    android:textColor="#43474f"
                    android:textSize="11sp" />

            <TextView
                    android:id="@+id/tvTiempoAcumuladoSeguimiento"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="end"
                    android:text="Acumulado: 00:15:30"
                    android:textColor="#001e40"
                    android:textSize="11sp"
                    android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>