<androidx.constraintlayout.widget.ConstraintLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#f9f9f8"> <com.google.android.material.card.MaterialCardView
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        app:cardBackgroundColor="#CCF9F9F8"
        app:cardElevation="8dp"
        app:cardCornerRadius="0dp"
        app:strokeWidth="0dp"
        app:layout_constraintTop_toTopOf="parent">

    <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingHorizontal="24dp">

        <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_back"
                app:tint="#191c1c"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"/>

        <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

            <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Zenda"
                    android:textSize="22sp"
                    android:fontFamily="sans-serif-black"
                    android:textStyle="italic"
                    android:textColor="#006a37"/>

            <LinearLayout
                    android:layout_width="32dp"
                    android:layout_height="4dp"
                    android:layout_marginTop="2dp"
                    android:orientation="horizontal">
                <View android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="2" android:background="#715c00"/>
                <View android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="#3456c1"/>
                <View android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="#ba1a1a"/>
            </LinearLayout>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>

    <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="24dp"
            app:layout_constraintTop_toBottomOf="@id/topBar"
            app:layout_constraintBottom_toBottomOf="parent">

        <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="¿Cómo vas a rodar?"
                android:textSize="32sp"
                android:textStyle="bold"
                android:textColor="#191c1c"
                android:textAlignment="center"/>

        <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Selecciona tu rol para continuar en la ruta"
                android:textSize="16sp"
                android:textColor="#3e4a3f"
                android:layout_marginTop="8dp"
                android:textAlignment="center"
                android:layout_marginBottom="48dp"/>

        <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardPasajero"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="#f3f4f3"
                app:cardCornerRadius="20dp"
                app:strokeWidth="0dp"
                app:rippleColor="#20006a37">

            <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="20dp">

                <View
                        android:id="@+id/iconBgPasajero"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:background="@drawable/bg_circle_primary"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"/>

                <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_person"
                        app:tint="#f6fff4"
                        app:layout_constraintTop_toTopOf="@id/iconBgPasajero"
                        app:layout_constraintBottom_toBottomOf="@id/iconBgPasajero"
                        app:layout_constraintStart_toStartOf="@id/iconBgPasajero"
                        app:layout_constraintEnd_toEndOf="@id/iconBgPasajero"/>

                <TextView
                        android:id="@+id/titlePasajero"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Pasajero"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="#191c1c"
                        android:layout_marginStart="16dp"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toTopOf="@id/descPasajero"
                        app:layout_constraintStart_toEndOf="@id/iconBgPasajero"
                        app:layout_constraintVertical_chainStyle="packed"/>

                <TextView
                        android:id="@+id/descPasajero"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Busco mi transporte"
                        android:textSize="14sp"
                        android:textColor="#3e4a3f"
                        app:layout_constraintTop_toBottomOf="@id/titlePasajero"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="@id/titlePasajero"/>

                <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_arrow_forward"
                        app:tint="#006a37"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardConductor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="#f3f4f3"
                app:cardCornerRadius="20dp"
                app:strokeWidth="0dp"
                app:rippleColor="#203456c1">

            <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="20dp">

                <View
                        android:id="@+id/iconBgConductor"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:background="@drawable/bg_circle_light_blue"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"/>

                <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_bus"
                        app:tint="#001550"
                        app:layout_constraintTop_toTopOf="@id/iconBgConductor"
                        app:layout_constraintBottom_toBottomOf="@id/iconBgConductor"
                        app:layout_constraintStart_toStartOf="@id/iconBgConductor"
                        app:layout_constraintEnd_toEndOf="@id/iconBgConductor"/>

                <TextView
                        android:id="@+id/titleConductor"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Conductor"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="#191c1c"
                        android:layout_marginStart="16dp"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toTopOf="@id/descConductor"
                        app:layout_constraintStart_toEndOf="@id/iconBgConductor"
                        app:layout_constraintVertical_chainStyle="packed"/>

                <TextView
                        android:id="@+id/descConductor"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Voy al mando del bus"
                        android:textSize="14sp"
                        android:textColor="#3e4a3f"
                        app:layout_constraintTop_toBottomOf="@id/titleConductor"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="@id/titleConductor"/>

                <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_arrow_forward"
                        app:tint="#3456c1"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>