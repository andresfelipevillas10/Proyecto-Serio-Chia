<?xml version="1.0" encoding="utf-8"?>
<!-- res/layout/item_stat_card.xml -->
<com.google.android.material.card.MaterialCardView
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardElevation="0dp"
        app:cardCornerRadius="16dp"
        app:cardBackgroundColor="@color/bg_zenda"
        app:strokeColor="@color/input_stroke"
        app:strokeWidth="1dp">

    <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="14dp"
            android:gravity="center_vertical">

        <!-- Ícono con fondo circular -->
        <FrameLayout
                android:layout_width="40dp"
                android:layout_height="40dp">
            <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_profile_circle"/>
            <ImageView
                    android:id="@+id/ivStatIcon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_bus"
                    app:tint="@color/primary_zenda"/>
        </FrameLayout>

        <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginStart="10dp">

            <TextView
                    android:id="@+id/tvStatValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="12"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_main"/>

            <TextView
                    android:id="@+id/tvStatLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="VIAJES HOY"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_variant"
                    android:letterSpacing="0.05"/>
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>