<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:background="@color/bg_zenda">

    <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="24dp">

        <!-- ── Barra superior ── -->
        <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_back"
                android:contentDescription="Volver"
                app:tint="@color/primary_zenda"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

        <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Zenda"
                android:textColor="@color/primary_zenda"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_marginStart="8dp"
                app:layout_constraintTop_toTopOf="@id/btnBack"
                app:layout_constraintBottom_toBottomOf="@id/btnBack"
                app:layout_constraintStart_toEndOf="@id/btnBack" />

        <!-- ── Avatar con botón de cámara ── -->
        <FrameLayout
                android:id="@+id/profileContainer"
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:layout_marginTop="20dp"
                app:layout_constraintTop_toBottomOf="@id/btnBack"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

            <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_profile_circle" />

            <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_person"
                    app:tint="@color/text_hint"
                    android:contentDescription="Foto de perfil" />

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                    android:id="@+id/btnPickPhoto"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|end"
                    android:src="@drawable/ic_camera"
                    android:contentDescription="Cambiar foto"
                    app:fabCustomSize="28dp"
                    app:maxImageSize="14dp"
                    app:backgroundTint="@color/primary_zenda"
                    app:tint="#FFFFFF"
                    app:elevation="4dp" />
        </FrameLayout>

        <!-- ── Título y subtítulo ── -->
        <TextView
                android:id="@+id/tvRegTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Crear Cuenta"
                android:textSize="26sp"
                android:textStyle="bold"
                android:textColor="@color/text_main"
                android:layout_marginTop="12dp"
                app:layout_constraintTop_toBottomOf="@id/profileContainer"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

        <TextView
                android:id="@+id/tvRegSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Únete al camino de la tranquilidad, conductor."
                android:textSize="13sp"
                android:textColor="@color/text_variant"
                android:textAlignment="center"
                android:layout_marginTop="4dp"
                app:layout_constraintTop_toBottomOf="@id/tvRegTitle"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

        <!-- Barra tricolor -->
        <LinearLayout
                android:id="@+id/accentBar"
                android:layout_width="56dp"
                android:layout_height="3dp"
                android:orientation="horizontal"
                android:layout_marginTop="8dp"
                app:layout_constraintTop_toBottomOf="@id/tvRegSubtitle"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">
            <View android:layout_width="0dp" android:layout_height="match_parent"
                    android:layout_weight="1" android:background="@color/accent_red" />
            <View android:layout_width="0dp" android:layout_height="match_parent"
                    android:layout_weight="1" android:background="@color/accent_yellow" />
            <View android:layout_width="0dp" android:layout_height="match_parent"
                    android:layout_weight="1" android:background="@color/accent_blue" />
        </LinearLayout>

        <!-- ── Formulario ── -->
        <LinearLayout
                android:id="@+id/formContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="20dp"
                app:layout_constraintTop_toBottomOf="@id/accentBar"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

            <!-- Nombre + Apellido -->
            <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:baselineAligned="false">

                <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginEnd="4dp">
                    <TextView style="@style/LabelStyle" android:text="NOMBRE" />
                    <com.google.android.material.textfield.TextInputLayout
                            style="@style/InputLayout"
                            android:layout_marginTop="4dp">
                        <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etNombre"
                                style="@style/InputEdit"
                                android:hint="Ej. Juan"
                                android:inputType="textPersonName" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>

                <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="4dp">
                    <TextView style="@style/LabelStyle" android:text="APELLIDO" />
                    <com.google.android.material.textfield.TextInputLayout
                            style="@style/InputLayout"
                            android:layout_marginTop="4dp">
                        <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etApellido"
                                style="@style/InputEdit"
                                android:hint="Ej. Pérez"
                                android:inputType="textPersonName" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Teléfono -->
            <TextView style="@style/LabelStyle" android:text="TELÉFONO"
                    android:layout_marginTop="12dp" />
            <com.google.android.material.textfield.TextInputLayout
                    style="@style/InputLayout"
                    android:layout_marginTop="4dp"
                    app:startIconDrawable="@drawable/ic_phone"
                    app:startIconTint="@color/text_hint">
                <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etTelefono"
                        style="@style/InputEdit"
                        android:hint="+57 300..."
                        android:inputType="phone" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Dirección -->
            <TextView style="@style/LabelStyle" android:text="DIRECCIÓN"
                    android:layout_marginTop="12dp" />
            <com.google.android.material.textfield.TextInputLayout
                    style="@style/InputLayout"
                    android:layout_marginTop="4dp"
                    app:startIconDrawable="@drawable/ic_location_on"
                    app:startIconTint="@color/text_hint">
                <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etDireccion"
                        style="@style/InputEdit"
                        android:hint="Calle 123..."
                        android:inputType="textPostalAddress" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Correo electrónico -->
            <TextView style="@style/LabelStyle" android:text="CORREO ELECTRÓNICO"
                    android:layout_marginTop="12dp" />
            <com.google.android.material.textfield.TextInputLayout
                    style="@style/InputLayout"
                    android:layout_marginTop="4dp"
                    app:startIconDrawable="@drawable/ic_mail"
                    app:startIconTint="@color/text_hint">
                <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etEmailReg"
                        style="@style/InputEdit"
                        android:hint="nombre@zenda.com"
                        android:inputType="textEmailAddress" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Contraseña -->
            <TextView style="@style/LabelStyle" android:text="CONTRASEÑA"
                    android:layout_marginTop="12dp" />
            <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/inputPassword"
                    style="@style/InputLayout"
                    android:layout_marginTop="4dp"
                    app:startIconDrawable="@drawable/ic_lock"
                    app:startIconTint="@color/text_hint"
                    app:endIconMode="password_toggle"
                    app:endIconTint="@color/text_hint">
                <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etPassReg"
                        style="@style/InputEdit"
                        android:hint="••••••••"
                        android:inputType="textPassword" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- No. Bus + Turno -->
            <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="12dp"
                    android:baselineAligned="false">

                <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginEnd="4dp">
                    <TextView style="@style/LabelStyle" android:text="NO. BUS" />
                    <com.google.android.material.textfield.TextInputLayout
                            style="@style/InputLayout"
                            android:layout_marginTop="4dp"
                            app:startIconDrawable="@drawable/ic_bus"
                            app:startIconTint="@color/text_hint">
                        <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etNoBus"
                                style="@style/InputEdit"
                                android:hint="204-A"
                                android:inputType="text" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>

                <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="4dp">
                    <TextView style="@style/LabelStyle" android:text="TURNO" />
                    <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/inputTurno"
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            app:boxBackgroundColor="@color/input_bg"
                            app:boxStrokeColor="@color/input_stroke"
                            app:boxCornerRadiusTopStart="12dp"
                            app:boxCornerRadiusTopEnd="12dp"
                            app:boxCornerRadiusBottomStart="12dp"
                            app:boxCornerRadiusBottomEnd="12dp"
                            app:startIconDrawable="@drawable/ic_schedule"
                            app:startIconTint="@color/text_hint">
                        <AutoCompleteTextView
                                android:id="@+id/atvTurno"
                                android:layout_width="match_parent"
                                android:layout_height="48dp"
                                android:hint="Mañana"
                                android:inputType="none"
                                android:textSize="14sp"
                                android:paddingStart="0dp" />
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Botón Registrarse -->
            <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRegister"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="28dp"
                    android:text="Registrarse"
                    android:textAllCaps="false"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    app:backgroundTint="@color/primary_zenda"
                    app:cornerRadius="100dp"
                    app:icon="@drawable/ic_arrow_forward"
                    app:iconGravity="textEnd"
                    app:iconTint="#FFFFFF" />

            <!-- Link a login -->
            <TextView
                    android:id="@+id/tvToLogin"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="16dp"
                    android:text="¿Ya tienes una cuenta? Iniciar Sesión"
                    android:textSize="13sp"
                    android:textColor="@color/text_variant" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>